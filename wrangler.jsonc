{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "physik2",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "physik2-db",
      "database_id": "d7d3c5ec-ee4d-4228-8802-20df1654ef92"
    }
  ]
}
